              "raw": "{{baseUrl}}/api/v1/auth/permissions?applicationId=",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "permissions" ],
              "query": [ { "key": "applicationId", "value": "", "description": "可选：按应用过滤" } ]
            }
          },
          "response": []
        }
      ]
