{
  "info": {
    "_postman_id": "b7e1c2d0-0000-4000-8000-000000000001",
    "name": "RBAC 统一权限管理平台（40 接口骨架）",
    "description": "对齐 api.md / 设计文档 §10 契约。\n\n使用步骤：\n1. 修改集合变量 baseUrl（默认 http://localhost:8080）。\n2. 执行「01 认证会话 / A01 登录」，测试脚本自动把 token 存入集合变量 accessToken。\n3. 其余接口统一使用 Bearer {{accessToken}}；写接口的 If-Match 需按读接口返回的 ETag 修改。\n4. struct 骨架下：读路径与登录链路真实可用，写路径返回 501 属预期。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "sampleUserId", "value": "1" },
    { "key": "sampleDeptId", "value": "1" },
    { "key": "sampleRoleId", "value": "1" },
    { "key": "sampleAppId", "value": "1" },
    { "key": "samplePermissionId", "value": "1" },
    { "key": "sampleLogId", "value": "1" },
    { "key": "logFrom", "value": "2026-10-01T00:00:00+08:00" },
    { "key": "logTo", "value": "2026-10-21T00:00:00+08:00" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{accessToken}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "01 认证会话",
      "item": [
        {
          "name": "A01 登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "    pm.collectionVariables.set('accessToken', body.data.token);",
                  "    pm.collectionVariables.set('userId', body.data.userId);",
                  "    console.log('已保存 accessToken，restricted=' + body.data.restricted);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ADMIN0001\",\n  \"password\": \"ChangeMe_2026a\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "auth", "login" ] },
            "description": "按种子数据修改用户名/密码。锁定与限流返回 429。"
          },
          "response": []
        },
        {
          "name": "A02 退出",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "auth", "logout" ] },
            "description": "幂等：无 Token / 旧 Token 重复退出均 200。"
          },
          "response": []
        },
        {
          "name": "A03 我的信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "auth", "me" ] }
          },
          "response": []
        },
        {
          "name": "A04 首次改密",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"ChangeMe_2026a\",\n  \"newPassword\": \"NewPass_2026b\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/password", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "auth", "password" ] },
            "description": "受限会话可调用；成功后撤销全部会话，需重新登录。"
          },
          "response": []
        },
        {
          "name": "A05 我的应用卡片",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/apps", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "auth", "apps" ] }
          },
          "response": []
        },
        {
          "name": "A06 我的权限",
