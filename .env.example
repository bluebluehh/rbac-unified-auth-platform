# Copy to .env.local. scripts/start-backend.ps1 loads this file.
# Spring Boot itself does not load dotenv files.
RBAC_DB_HOST=127.0.0.1
RBAC_DB_PORT=3306
RBAC_DB_NAME=rbac_platform
RBAC_DB_USER=root
RBAC_DB_PASSWORD=
# Generate once: openssl rand -base64 32. Preserve this key for the same database.
RBAC_PHONE_KEY=
RBAC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RBAC_BUSINESS_MODE=DISABLED
# Required only for an existing course database:
# SPRING_PROFILES_ACTIVE=course
# RBAC_BUSINESS_MODE=PERMISSION_DISPLAY_ONLY
# RBAC_COURSE_DATASOURCE_ID=jdbc:mysql://127.0.0.1:3306/rbac_platform
